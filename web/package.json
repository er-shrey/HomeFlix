{
  "name": "@homeflix/web",
  "version": "0.2.0",
  "private": true,
  "description": "HomeFlix frontend: the web app, also packaged as the Android phone/TV app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
