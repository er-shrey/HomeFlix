    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
