{
  "name": "homeflix",
  "version": "0.2.0",
  "private": true,
  "description": "A Netflix-style media server for your home network, with web and Android apps",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "mock": "node scripts/make-mock-library.js",
    "android:apk": "npm run android:apk -w web"
  }
}
